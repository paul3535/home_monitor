[Unit]
Description=Home monitor (freezer temperatures and door switches)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/home_monitor
EnvironmentFile=/etc/home_monitor.env
ExecStart=/home/pi/home_monitor/.venv/bin/python -m home_monitor -c /home/pi/home_monitor/config.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
